generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  SELLER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String?
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)

  shop         Shop?
  orders       Order[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Shop {
  id          Int      @id @default(autoincrement())
  name        String
  username    String?
  slug        String   @unique
  description String?
  location    String?
  followers   String?
  initials    String?
  instagram   String?

  ownerId     Int      @unique
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  products    Product[]
  orders      Order[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique

  shops       Shop[]
  products    Product[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  description String?
  price       Decimal   @db.Decimal(12, 2)
  image       String?

  shopId      Int
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  orderItems  OrderItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shopId])
  @@index([categoryId])
}

model Order {
  id          Int         @id @default(autoincrement())
  status      OrderStatus @default(PENDING)

  userId      Int
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  shopId      Int
  shop        Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)

  items       OrderItem[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
  @@index([shopId])
}

model OrderItem {
  id          Int      @id @default(autoincrement())

  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId   Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity    Int
  price       Decimal  @db.Decimal(12, 2)

  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}